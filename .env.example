# Optional Grafana Cloud Pyroscope connection settings for the rideshare-k8s example.
# This uninstrumented branch does not consume these values until you add the
# profiling changes described in README.md.
# Copy this file to .env and fill in your values when enabling profiling.
# The real .env is gitignored so your token is not committed.
#
# Find these values in your Grafana Cloud stack:
#   https://grafana.com/profile/org/stacks -> your stack -> Pyroscope -> "Send Profiles".

# Grafana Cloud Pyroscope endpoint (e.g. https://profiles-prod-001.grafana.net).
PYROSCOPE_SERVER_ADDRESS=https://profiles-prod-001.grafana.net

# Stack / instance ID — the numeric "User" shown for the Pyroscope endpoint.
PYROSCOPE_BASIC_AUTH_USER=123456

# Grafana Cloud access policy token with the profiles:write scope.
PYROSCOPE_BASIC_AUTH_PASSWORD=glc_your_token_here

# Application name shown in Grafana Cloud Profiles.
PYROSCOPE_APPLICATION_NAME=rust-ride-sharing-app
